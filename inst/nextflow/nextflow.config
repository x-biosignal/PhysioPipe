// Execution profiles for the PhysioPipe Nextflow bindings.
// Default runs locally (uses the R library on PATH — good for dev). The
// docker / singularity profiles run every process in the published image, so
// the same pipeline is reproducible on HPC and cloud.
//
//   nextflow run ecg_hrv.nf --records 'data/*.hea'                    # local
//   nextflow run ecg_hrv.nf --records 'data/*.hea' -profile docker
//   nextflow run ecg_hrv.nf --records 'data/*.hea' -profile singularity

profiles {
    standard    { }                                          // local, no container
    docker      { docker.enabled = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
}

process {
    cpus   = 1
    memory = '2 GB'
}
